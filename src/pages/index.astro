---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const topics = [
	{ label: 'Viết & phát triển blog', count: '42 bài', icon: '✦' },
	{ label: 'AI cho người làm độc lập', count: '18 bài', icon: '◌' },
	{ label: 'Kinh doanh một người', count: '26 bài', icon: '↗' },
	{ label: 'Tự do tài chính', count: '31 bài', icon: '⌁' },
];

const articles = [
	{ category: 'AI & CÔNG VIỆC', title: 'Lộ trình học AI trong 30 ngày cho người mới', description: 'Một cách học chậm rãi, có mục đích để đưa AI vào đúng những công việc bạn đang làm mỗi ngày.', meta: '14 THG 01, 2026 · 8 PHÚT ĐỌC', className: 'article-image--orange' },
	{ category: 'HÀNH TRÌNH', title: '10 năm làm việc online đã dạy mình điều gì?', description: 'Không phải 10 bí quyết. Chỉ là những điều đủ thật để giúp bạn đi lâu hơn trên con đường của mình.', meta: '31 THG 08, 2025 · 6 PHÚT ĐỌC', className: 'article-image--blue' },
	{ category: 'KIẾN THỨC NỀN', title: 'Bắt đầu một blog, rồi biến nó thành một nơi đáng quay lại', description: 'Từ một trang trắng đến hệ thống nội dung có ích cho người đọc lẫn công việc của chính bạn.', meta: '06 THG 06, 2025 · 10 PHÚT ĐỌC', className: 'article-image--green' },
];
---

<!doctype html>
<html lang="vi">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero container" aria-labelledby="hero-title">
				<p class="eyebrow">MỘT GÓC NHỎ CỦA NGỌC</p>
				<h1 id="hero-title">Làm chủ công việc.<br /><em>Sống theo cách của mình.</em></h1>
				<p class="hero-copy">Những ghi chép thực tế về viết lách, công việc tự do và xây dựng một doanh nghiệp vừa vặn với cuộc sống.</p>
				<div class="hero-actions"><a class="button button--primary" href="#bai-viet">Đọc bài mới nhất <span aria-hidden="true">↓</span></a><a class="text-link" href="#chu-de">Khám phá chủ đề <span aria-hidden="true">→</span></a></div>
			</section>

			<section class="featured container" aria-labelledby="featured-title">
				<div class="feature-art" aria-hidden="true"><div class="sun"></div><div class="horizon horizon--back"></div><div class="horizon horizon--front"></div><div class="window"></div><span>ND</span></div>
				<div class="featured-copy"><p class="eyebrow">BÀI VIẾT NỔI BẬT</p><h2 id="featured-title">Từ người làm tự do đến một doanh nghiệp một người</h2><p>Con đường này không cần lớn thật nhanh. Nó cần một hệ thống đủ gọn để bạn có thể làm việc tốt, sống bình tĩnh và không bỏ quên điều quan trọng.</p><a class="read-link" href="/blog">Đọc câu chuyện <span aria-hidden="true">→</span></a></div>
			</section>

			<section class="topics container" id="chu-de" aria-labelledby="topics-title">
				<div class="section-heading"><div><p class="eyebrow">BẮT ĐẦU TỪ ĐÂY</p><h2 id="topics-title">Bạn đang muốn đi đâu?</h2></div><a class="text-link" href="/blog">Xem tất cả bài viết <span aria-hidden="true">→</span></a></div>
				<div class="topic-grid">{topics.map((topic) => <a class="topic-card" href="/blog"><span class="topic-icon" aria-hidden="true">{topic.icon}</span><span class="topic-name">{topic.label}</span><span class="topic-count">{topic.count} <span aria-hidden="true">↗</span></span></a>)}</div>
			</section>

			<section class="reading container" id="bai-viet" aria-labelledby="reading-title">
				<div class="section-heading"><div><p class="eyebrow">ĐỌC GẦN ĐÂY</p><h2 id="reading-title">Những điều đang được viết</h2></div><a class="text-link" href="/blog">Xem lưu trữ <span aria-hidden="true">→</span></a></div>
				<div class="article-grid">{articles.map((article) => <article class="article-card"><a class:list={['article-image', article.className]} href="/blog" aria-label={article.title}><span aria-hidden="true">NĐR</span></a><div class="article-body"><p class="article-category">{article.category}</p><h3><a href="/blog">{article.title}</a></h3><p>{article.description}</p><small>{article.meta}</small></div></article>)}</div>
			</section>

			<section class="newsletter container" id="newsletter" aria-labelledby="newsletter-title"><div><p class="eyebrow">THƯ GỬI MỖI THỨ BA</p><h2 id="newsletter-title">Một lá thư ngắn,<br />một ý tưởng đáng giữ.</h2></div><form class="newsletter-form"><label for="email">Địa chỉ email của bạn</label><div class="input-row"><input id="email" name="email" type="email" placeholder="ban@email.com" autocomplete="email" /><button type="submit">Đăng ký <span aria-hidden="true">→</span></button></div><p class="form-note">Không spam. Chỉ những điều có ích cho hành trình của bạn.</p></form></section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { background: var(--paper); color: var(--ink); }
	.container { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
	.hero { padding: clamp(5.5rem, 12vw, 10.5rem) 0 clamp(5rem, 10vw, 8rem); text-align: center; }
	.eyebrow, .article-category { color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .14em; margin: 0 0 1.15rem; }
	h1, h2, h3 { font-family: var(--font-display); font-weight: 600; letter-spacing: -.055em; }
	h1 { color: var(--ink); font-size: clamp(3.25rem, 7.4vw, 6.4rem); line-height: .98; margin: 0; }
	h1 em { color: var(--accent); font-weight: 400; }
	.hero-copy { color: var(--body); font-size: clamp(1.05rem, 1.7vw, 1.25rem); line-height: 1.7; margin: 2rem auto 0; max-width: 610px; }
	.hero-actions { align-items: center; display: flex; gap: 1.75rem; justify-content: center; margin-top: 2.6rem; }
	.button { align-items: center; border-radius: 999px; display: inline-flex; font-size: .9rem; font-weight: 700; gap: .7rem; padding: .95rem 1.35rem; text-decoration: none; }
	.button--primary { background: var(--ink); color: var(--paper); transition: transform .2s, background .2s; }
	.button--primary:hover { background: var(--accent); color: white; transform: translateY(-2px); }
	.text-link, .read-link { color: var(--ink); font-size: .9rem; font-weight: 700; text-decoration: none; }
	.text-link span, .read-link span { color: var(--accent); margin-left: .3rem; }
	.featured { background: var(--feature); border-radius: 28px; display: grid; grid-template-columns: 1fr 1fr; min-height: 490px; overflow: hidden; }
	.feature-art { background: #d98461; min-height: 330px; overflow: hidden; position: relative; }
	.feature-art span { bottom: 1.4rem; color: rgba(42, 38, 31, .72); font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; left: 1.7rem; position: absolute; }
	.sun { background: #efbb75; border-radius: 50%; height: 150px; left: 19%; position: absolute; top: 14%; width: 150px; }
	.horizon { background: #34443b; border-radius: 60% 60% 0 0; bottom: -15%; height: 52%; position: absolute; width: 125%; }
	.horizon--back { background: #738b70; bottom: 5%; left: -38%; transform: rotate(-5deg); }
	.horizon--front { left: 8%; }
	.window { border: 2px solid rgba(255,255,255,.4); border-radius: 999px 999px 0 0; height: 63%; position: absolute; right: 14%; top: 18%; width: 35%; }
	.featured-copy { align-self: center; padding: clamp(2.5rem, 6vw, 5.5rem); }
	h2 { color: var(--ink); font-size: clamp(2.15rem, 3.8vw, 3.6rem); line-height: 1.04; margin: 0; }
	.featured-copy > p:not(.eyebrow) { color: var(--body); font-size: 1rem; line-height: 1.75; margin: 1.6rem 0 2.2rem; }
	.topics, .reading { padding-top: clamp(5rem, 10vw, 8.5rem); }
	.section-heading { align-items: flex-end; display: flex; justify-content: space-between; margin-bottom: 2.5rem; }
	.section-heading .eyebrow { margin-bottom: .85rem; }
	.section-heading h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); }
	.topic-grid { display: grid; gap: 12px; grid-template-columns: repeat(4, 1fr); }
	.topic-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; color: var(--ink); display: flex; flex-direction: column; min-height: 180px; padding: 1.25rem; text-decoration: none; transition: border-color .2s, transform .2s; }
	.topic-card:hover { border-color: var(--accent); transform: translateY(-4px); }
	.topic-icon { color: var(--accent); font-size: 1.55rem; }
	.topic-name { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.15; margin-top: auto; }
	.topic-count { color: var(--muted); font-size: .75rem; margin-top: .45rem; }
	.topic-count span { color: var(--accent); float: right; font-size: 1rem; }
	.article-grid { display: grid; gap: 1.8rem; grid-template-columns: repeat(3, 1fr); }
	.article-image { align-items: center; border-radius: 16px; display: flex; height: 220px; justify-content: center; overflow: hidden; position: relative; text-decoration: none; }
	.article-image::after { border: 1px solid rgba(255,255,255,.52); border-radius: 50%; content: ''; height: 42%; position: absolute; width: 42%; }
	.article-image span { color: rgba(31, 33, 29, .73); font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; z-index: 1; }
	.article-image--orange { background: linear-gradient(135deg, #e9c09b 0 35%, #be6d4f 35% 70%, #443e37 70%); }
	.article-image--blue { background: linear-gradient(145deg, #b7c5bd 0 36%, #637686 36% 74%, #d5a989 74%); }
	.article-image--green { background: linear-gradient(135deg, #c9b97d 0 34%, #526c57 34% 69%, #a7bbad 69%); }
	.article-body { padding: 1.35rem .2rem; }
	.article-body h3 { font-size: 1.55rem; line-height: 1.12; margin: 0; }
	.article-body h3 a { color: var(--ink); text-decoration: none; }
	.article-body > p:not(.article-category) { color: var(--body); font-size: .9rem; line-height: 1.65; margin: 1rem 0; }
	.article-body small { color: var(--muted); font-size: .68rem; font-weight: 700; letter-spacing: .07em; }
	.newsletter { align-items: center; background: var(--ink); border-radius: 24px; color: var(--paper); display: grid; gap: 3rem; grid-template-columns: 1fr 1fr; margin-bottom: clamp(5rem, 10vw, 8rem); margin-top: clamp(5rem, 10vw, 8.5rem); padding: clamp(2rem, 5vw, 4rem); }
	.newsletter .eyebrow { color: #a7b4a3; }
	.newsletter h2 { color: white; font-size: clamp(2.1rem, 3.7vw, 3.3rem); }
	.newsletter-form label { display: block; font-size: .8rem; margin-bottom: .7rem; }
	.input-row { display: flex; }
	.input-row input { background: transparent; border: 1px solid #536153; border-radius: 8px 0 0 8px; color: white; font: inherit; min-width: 0; padding: .95rem 1rem; width: 100%; }
	.input-row input:focus { outline: 2px solid #c6ddbc; outline-offset: 2px; }
	.input-row button { background: #c6ddbc; border: 0; border-radius: 0 8px 8px 0; color: #1f2c20; cursor: pointer; font: inherit; font-size: .85rem; font-weight: 700; padding: .95rem 1.1rem; white-space: nowrap; }
	.form-note { color: #a7b4a3; font-size: .72rem; line-height: 1.5; margin: .8rem 0 0; }
	@media (max-width: 780px) { .container { width: min(100% - 32px, 1120px); } .featured, .newsletter { grid-template-columns: 1fr; } .featured-copy { padding: 2.5rem; } .topic-grid { grid-template-columns: repeat(2, 1fr); } .article-grid { grid-template-columns: 1fr; gap: 2rem; } .article-image { height: 240px; } .section-heading .text-link { display: none; } }
	@media (max-width: 480px) { .hero { padding-top: 4.7rem; } .hero-actions { flex-direction: column; gap: 1.2rem; } .topic-grid { gap: 9px; } .topic-card { min-height: 150px; padding: 1rem; } .topic-name { font-size: 1.05rem; } .featured { border-radius: 20px; } .newsletter { border-radius: 18px; } }
</style>
