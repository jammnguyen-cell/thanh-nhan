<header class="site-header">
  <nav class="nav-shell" aria-label="Điều hướng chính">
    <a class="brand" href="/" aria-label="Ngọc Đến Rồi, về trang chủ">ngọc<span>đến</span>rồi</a>
    <div class="nav-links"><a href="/blog">Bài viết</a><a href="/about">Về Ngọc</a><a href="/#newsletter">Nhận thư</a></div>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Đổi giao diện" aria-pressed="false" data-theme-toggle>
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 15.5A8.8 8.8 0 0 1 8.5 3.4 8.8 8.8 0 1 0 20.6 15.5Z"/></svg>
        <span data-theme-label>Sáng</span>
      </button>
      <a class="search" href="/blog" aria-label="Tìm bài viết"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.2 4.2"/></svg></a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');
  const root = document.documentElement;
  function updateButton() {
    const isDark = root.dataset.theme === 'dark';
    if (toggle) toggle.setAttribute('aria-pressed', String(isDark));
    if (label) label.textContent = isDark ? 'Tối' : 'Sáng';
  }
  updateButton();
  toggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    localStorage.setItem('ndr-theme', nextTheme);
    updateButton();
  });
</script>

<style>
  .site-header { background: color-mix(in srgb, var(--paper) 92%, transparent); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(12px); }
  .nav-shell { align-items: center; display: flex; height: 74px; justify-content: space-between; margin: 0 auto; width: min(1120px, calc(100% - 48px)); }
  .brand { color: var(--ink); font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; letter-spacing: -.08em; text-decoration: none; }
  .brand span { color: var(--accent); }
  .nav-links { display: flex; gap: 1.7rem; margin-left: 5rem; margin-right: auto; }
  .nav-links a { color: var(--body); font-size: .85rem; font-weight: 600; text-decoration: none; }
  .nav-links a:hover { color: var(--accent); }
  .nav-actions { align-items: center; display: flex; gap: .45rem; }
  .theme-toggle, .search { align-items: center; background: transparent; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); display: inline-flex; font: inherit; gap: .4rem; height: 38px; justify-content: center; padding: 0 .7rem; }
  .theme-toggle { cursor: pointer; font-size: .73rem; font-weight: 700; }
  .theme-toggle svg, .search svg { fill: none; height: 16px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; width: 16px; }
  .moon-icon { display: none; }
  :global([data-theme='dark']) .sun-icon { display: none; }
  :global([data-theme='dark']) .moon-icon { display: block; }
  .search { padding: 0; width: 38px; }
  @media (max-width: 680px) { .nav-shell { height: 64px; width: calc(100% - 32px); } .nav-links { display: none; } .theme-toggle { padding: 0 .62rem; } }
</style>
